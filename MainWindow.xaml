<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI_FileExplorer_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI_FileExplorer_App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinUI File/Folder Picker Demo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer Padding="20">
        <StackPanel Spacing="20">

            <!-- CASE 1: Open File Picker (Multiple Files) -->
            <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Case 1: FileOpenPicker" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Select multiple files of any type" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <!-- Location: TextBox + Browse Button -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Location" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" x:Name="Case1LocationTextBox" 
                                     IsReadOnly="True" PlaceholderText="No files selected"/>
                            <Button Grid.Column="1" Content="..." Click="OpenFilePickerCase1_Click"
                                    Background="Transparent" Width="40" Height="40"
                                    ToolTipService.ToolTip="Browse files"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- CASE 2: Open Folder Picker (Navigate) -->
            <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Case 2: FolderPicker" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Select a folder and view its contents" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <!-- Location: TextBox + Browse Button -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Location" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" x:Name="Case2LocationTextBox"
                                     IsReadOnly="True" PlaceholderText="No folder selected"/>
                            <Button Grid.Column="1" Content="..." Click="OpenFolderPickerCase2_Click"
                                    Background="Transparent" Width="40" Height="40"
                                    ToolTipService.ToolTip="Browse folders"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- CASE 3: Image File Picker (PNG &amp; Images Only) -->
            <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Case 3: Image Picker (PNG/Images Only)" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Select image files (PNG, JPG, BMP, GIF, WEBP)" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <!-- Location: TextBox + Browse Button -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Location" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" x:Name="Case3LocationTextBox"
                                     IsReadOnly="True" PlaceholderText="No images selected"/>
                            <Button Grid.Column="1" Content="..." Click="OpenImagePickerCase3_Click"
                                    Background="Transparent" Width="40" Height="40"
                                    ToolTipService.ToolTip="Browse images"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
